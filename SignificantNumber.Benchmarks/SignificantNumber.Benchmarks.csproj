<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- BenchmarkDotNet finds the project that produced a benchmark assembly by matching the
         assembly name against .csproj file names. ktsu.Sdk would otherwise name the output
         ktsu.SignificantNumber.Benchmarks, which matches no project file. -->
    <AssemblyName>SignificantNumber.Benchmarks</AssemblyName>
    <RootNamespace>ktsu.SignificantNumber.Benchmarks</RootNamespace>
    <!-- Benchmarks are tooling: not shipped, and not something unit tests cover. Telling the
         Sonar scanner so here keeps the coverage gate off this project's back. -->
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BenchmarkDotNet.Annotations" />
    <!-- Referenced directly rather than borrowed from the library through InternalsVisibleTo,
         because the benchmarks also run against published packages that expose nothing. -->
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <!-- Normally the working copy. Set BenchmarkAgainstVersion to measure a released package
       instead, in the environment of the same `dotnet run` that names this project, as
       `BenchmarkAgainstVersion=1.4.40 dotnet run -c Release ...`. An environment
       variable rather than a `-p:` switch, because BenchmarkDotNet builds each
       benchmark in an autogenerated project of its own, which a property set on the outer run
       never reaches. MSBuild reads environment variables as properties in every project,
       including that one.

       That switch is how the release history is charted. No tag in this repository carries a
       benchmark project, so there is no older source to check out and run; measuring published
       packages with today's benchmarks is the only way to reach back, and it is the better
       measurement anyway because every version is timed by identical code.

       It is also why nothing here touches an internal member. The InternalsVisibleTo that would
       expose one is not in the packages already published, so a benchmark that used internals
       could only ever measure the working copy. -->
  <ItemGroup Condition="'$(BenchmarkAgainstVersion)' == ''">
    <ProjectReference Include="..\SignificantNumber\SignificantNumber.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BenchmarkAgainstVersion)' != ''">
    <PackageReference Include="ktsu.SignificantNumber" VersionOverride="$(BenchmarkAgainstVersion)" />
  </ItemGroup>

  <!-- Significant-digit reduction is the one benchmark whose spelling the older packages do not
       share: 1.2.x has no precision overload of ToSignificantNumber at all, and 1.3 and 1.4.0
       hang it off the PreciseNumber base, where the receiver's type argument has to be written
       out. Carrying three spellings of one benchmark would measure the spellings; dropping the
       file from those builds measures everything else instead, and the chart draws the panel
       with a gap rather than losing six panels to a compile error. -->
  <ItemGroup Condition="'$(BenchmarkAgainstVersion)' != '' AND $([System.Version]::Parse('$(BenchmarkAgainstVersion)').CompareTo($([System.Version]::Parse('1.4.20')))) &lt; 0">
    <Compile Remove="SignificanceBenchmarks.cs" />
  </ItemGroup>

</Project>
